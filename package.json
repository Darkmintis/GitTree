{
  "name": "gittree",
  "displayName": "GitTree",
  "description": "Visualize your Git repository as a living, interactive tree. Every commit grows your tree.",
  "version": "1.0.0",
  "publisher": "gittree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkmintis/GitTree"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "tree",
    "visualization",
    "history",
    "commits"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onCommand:gittree.showTree",
    "onCommand:gittree.refresh",
    "onView:gittree.sidebar"
  ],
  "main": "./extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gittree.showTree",
        "title": "Show Tree",
        "category": "GitTree",
        "icon": {
          "light": "assets/icons/tree.svg",
          "dark": "assets/icons/tree.svg"
        }
      },
      {
        "command": "gittree.refresh",
        "title": "Refresh",
        "category": "GitTree",
        "icon": "$(refresh)"
      },
      {
        "command": "gittree.exportSnapshot",
        "title": "Export Snapshot",
        "category": "GitTree",
        "icon": "$(save)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gittree",
          "title": "GitTree",
          "icon": "assets/icons/tree.svg"
        }
      ]
    },
    "views": {
      "gittree": [
        {
          "type": "tree",
          "id": "gittree.sidebar",
          "name": "GitTree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gittree.sidebar",
        "contents": "See your Git history as a living 3D tree.\n[Open GitTree](command:gittree.showTree)\n\nOpen a folder that is a Git repository, then click the button above."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gittree.showTree",
          "when": "view == gittree.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "gittree.refresh",
          "when": "view == gittree.sidebar",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "gittree.showTree",
          "when": "view == gittree.sidebar",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "GitTree",
      "properties": {
        "gittree.animationSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 3,
          "description": "Animation speed multiplier"
        },
        "gittree.theme": {
          "type": "string",
          "default": "oak",
          "enum": [
            "oak",
            "sakura",
            "pine"
          ],
          "description": "Tree theme (Oak, Sakura, or Pine)"
        },
        "gittree.windEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable wind animation"
        },
        "gittree.performanceMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable performance mode for large repos"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build:extension": "node esbuild.js --production",
    "dev:extension": "node esbuild.js --sourcemap --watch",
    "build:webview": "cd webview && npm run build",
    "dev:webview": "cd webview && npm run dev",
    "build": "npm run build:extension && npm run build:webview",
    "dev": "node esbuild.js --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
