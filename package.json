{
  "name": "gittree",
  "displayName": "GitTree",
  "description": "Visualize your Git repository as a living, interactive tree. Every commit grows your tree.",
  "version": "1.0.0",
  "publisher": "gittree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkmintis/GitTree"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "git",
    "tree",
    "visualization",
    "history",
    "commits"
  ],
  "icon": "assets/icon.png",
  "activationEvents": [
    "onCommand:gittree.showTree",
    "onCommand:gittree.refresh",
    "onView:gittree.sidebar"
  ],
  "main": "./extension/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gittree.showTree",
        "title": "GitTree: Show Tree"
      },
      {
        "command": "gittree.refresh",
        "title": "GitTree: Refresh"
      },
      {
        "command": "gittree.exportSnapshot",
        "title": "GitTree: Export Snapshot"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gittree",
          "title": "GitTree",
          "icon": "assets/icons/tree.svg"
        }
      ]
    },
    "views": {
      "gittree": [
        {
          "type": "tree",
          "id": "gittree.sidebar",
          "name": "Repository"
        }
      ]
    },
    "configuration": {
      "title": "GitTree",
      "properties": {
        "gittree.animationSpeed": {
          "type": "number",
          "default": 1.0,
          "minimum": 0,
          "maximum": 3,
          "description": "Animation speed multiplier"
        },
        "gittree.theme": {
          "type": "string",
          "default": "oak",
          "enum": [
            "oak",
            "sakura",
            "pine",
            "maple",
            "fantasy",
            "cyber",
            "pixel",
            "minimal",
            "darkForest",
            "crystal",
            "bonsai"
          ],
          "description": "Tree theme"
        },
        "gittree.showLeaves": {
          "type": "boolean",
          "default": true,
          "description": "Show commit leaves"
        },
        "gittree.showFruits": {
          "type": "boolean",
          "default": true,
          "description": "Show PR fruits"
        },
        "gittree.showFlowers": {
          "type": "boolean",
          "default": true,
          "description": "Show release flowers"
        },
        "gittree.particleEffects": {
          "type": "boolean",
          "default": true,
          "description": "Enable particle effects"
        },
        "gittree.windEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable wind animation"
        },
        "gittree.performanceMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable performance mode for large repos"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:extension",
    "build:extension": "node esbuild.js --production",
    "dev:extension": "node esbuild.js --sourcemap --watch",
    "build:webview": "cd webview && npm run build",
    "dev:webview": "cd webview && npm run dev",
    "build": "npm run build:extension && npm run build:webview",
    "dev": "node esbuild.js --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "simple-git": "^3.22.0"
  }
}
